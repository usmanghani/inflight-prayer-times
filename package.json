{
  "name": "inflight-prayer-times",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side, open-source in-flight Islamic prayer time calculator",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:airports": "node scripts/build-airports.mjs",
    "fixtures:verify": "NODE_USE_ENV_PROXY=1 vite-node scripts/fixtures/verify-library.ts",
    "fixtures:live": "NODE_USE_ENV_PROXY=1 vite-node scripts/fixtures/capture-live.ts",
    "fixtures:history": "NODE_USE_ENV_PROXY=1 vite-node scripts/fixtures/fetch-history.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/fixtures/tsconfig.json",
    "route-report": "vite-node scripts/route-report.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "tesseract.js": "^7.0.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "vite": "^6.4.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
